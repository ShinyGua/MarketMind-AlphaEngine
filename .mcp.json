{
  "mcpServers": {
    "market-data": {
      "command": ".venv/bin/python3",
      "args": ["mcp/market_data_server.py"],
      "comment": "API keys (NEWSAPI_KEY, FRED_API_KEY) are loaded from the project .env at server startup; never commit secrets here.",
      "env": {}
    },
    "mm-workspace": {
      "command": ".venv/bin/python3",
      "args": ["mcp/workspace_server.py"],
      "env": {
        "WORKSPACES_DIR": "workspaces"
      }
    },
    "memory": {
      "command": ".venv/bin/python3",
      "args": ["mcp/memory_server.py"],
      "env": {
        "MEMORY_DIR": "memory"
      }
    }
  }
}
