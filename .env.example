# MarketMind-AlphaEngine — local API keys (free tier).
# Copy to `.env` and fill in real values. `.env` is gitignored; this template is not.
# The market-data MCP server loads these at startup (mcp/shared/dotenv.py); no shell
# export needed. Already-set environment variables take precedence over this file.

# NewsAPI (free tier, https://newsapi.org) — market/sector/company headlines.
# NEWSAPI_API_KEY is also accepted as an alias for NEWSAPI_KEY.
NEWSAPI_KEY=

# FRED (free, https://fred.stlouisfed.org/docs/api/api_key.html) — macro series.
FRED_API_KEY=
